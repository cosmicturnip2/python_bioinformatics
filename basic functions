BASES = {"A", "C", "G", "T"} 

def validate_dna_sequence(raw_dna_sequence: str)-> str | None:
    """
    Validate and normalise a raw DNA sequence string.

    Args:
        dna_sequence (str): The original, raw DNA sequence as a string.
    Returns:
        validated_sequence (str | None): Uppercased valid sequence or None.
    """

    if not raw_dna_sequence:
        return None

    if not isinstance(raw_dna_sequence, str):
        return None

    validated_sequence = raw_dna_sequence.strip().upper()

    if not set(validated_sequence).issubset(BASES):
        return None
    return validated_sequence


def count_bases(valid_dna_sequence: str)-> dict[str, int]:
    """
    Count the bases of a pre-validated DNA sequence.

    Args:
        dna_sequence (str): The input DNA sequence as a string.
    Returns:
        nucleotide_count (dict[str, int]): All single base counts.
    """

    return {base: valid_dna_sequence.count(base) for base in BASES}
